{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "echo lint ok",
    "db:migrate": "kysely-ctl migrate:latest",
    "db:codegen": "kysely-codegen --out-file src/generated.ts --url env:DATABASE_URL"
  },
  "dependencies": {
    "kysely": "^0.29.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "kysely-ctl": "^0.21.0",
    "kysely-codegen": "^0.20.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.4"
  }
}